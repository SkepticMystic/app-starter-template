# Every name here must be present and non-empty, or the container refuses to
# start.
#
# This is belt to src/env.ts's braces. src/env.ts validates values (a URL is a
# URL, APP_ENV is one of three tiers) inside Server.init(), which is the real
# guarantee. This list is cruder and earlier: it fails before Node even loads
# the app, so a missing DATABASE_URL reads as one clear line rather than a
# stack trace, and it covers the variables adapter-node itself consumes —
# ORIGIN in particular — which src/env.ts does not know about.
#
# Variables that may legitimately be blank are NOT listed: the Google and
# Pocket ID credentials (blank disables the provider), the Sentry DSN, the two
# Umami values, and NO_COLOR.

APP_ENV
ORIGIN
PUBLIC_BASE_URL
DATABASE_URL
BETTER_AUTH_SECRET
UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN
R2_BUCKET_NAME
R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY
CLOUDFLARE_ACCOUNT_ID
RESEND_API_KEY
EMAIL_FROM
CAPTCHA_SECRET_KEY
PUBLIC_CAPTCHA_SITE_KEY
CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET
CLOUDINARY_UPLOAD_PRESET
OPENAI_API_KEY
PAYSTACK_SECRET_KEY
LOG_LEVEL
