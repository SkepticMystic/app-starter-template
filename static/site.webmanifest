{
  "short_name": "App",
  "name": "App Starter",
  "description": "An awesome app built with SvelteKit and BetterAuth",
  "categories": ["utilities", "productivity"],

  "theme_color": "#f8f8f8",
  "background_color": "#f8f8f8",

  "display": "minimal-ui",
  "start_url": "/?source=pwa",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },

  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
