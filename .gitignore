.mcp.json

# Editors
# Editor config is deliberately shared (it pins the formatter/linter so the
# whole team gets the same diagnostics), so allowlist the project-level files.
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.zed/*
!.zed/settings.json
!.zed/tasks.json
!.zed/debug.json
*.code-workspace
*.swp
*.swo
*~

# Logs / cache
*.log
.cache/

# Agent scratch — nested git worktrees live here and must never be
# formatted, linted, or scanned as part of this checkout.
.claude/worktrees/
.claude/scheduled_tasks.lock
