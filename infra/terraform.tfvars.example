# Copy to terraform.tfvars and fill in.
#
# This file is generated by hand FROM infra/variables.tf. When you add or
# remove a variable there, update it here — the previous version had drifted in
# both directions at once, listing variables that no longer existed
# (r2_access_key_id, turnstile_domains) while omitting four that are REQUIRED,
# so a fresh clone could not `tofu apply` at all.
#
# terraform.tfvars is gitignored and contains live credentials.

# ---------------------------------------------------------------------------
# Required — no defaults. `tofu apply` fails without every one of these.
# ---------------------------------------------------------------------------

# Neon — https://console.neon.tech/app/settings/api-keys
neon_api_key = ""
neon_org_id  = ""

# Upstash — https://console.upstash.com/account/api
upstash_email   = ""
upstash_api_key = ""

# Cloudflare — token needs R2 edit + Turnstile edit on the account
cloudflare_api_token  = ""
cloudflare_account_id = ""

# GitHub — PAT with `repo` scope. Writes the per-tier environment blobs and the
# deploy key as Actions secrets, which is what keeps OpenTofu the sole writer
# of environment configuration.
github_token = ""
github_repo  = "owner/repo"

# The VPS. `deploy_known_hosts` is pinned so CI never uses
# StrictHostKeyChecking=no; get it with `ssh-keyscan -t ed25519 <deploy_host>`.
deploy_host            = ""
deploy_ssh_private_key = ""
deploy_known_hosts     = ""

# Better-Auth. Generate with `openssl rand -base64 32`. Changing these
# invalidates every existing session and every pending verification link.
better_auth_secret     = ""
better_auth_secret_dev = ""

# Cloudinary
cloudinary_cloud_name    = ""
cloudinary_api_key       = ""
cloudinary_api_secret    = ""
cloudinary_upload_preset = ""

# OpenAI — used by the image moderation service
openai_api_key = ""

# ---------------------------------------------------------------------------
# Optional — these have defaults in variables.tf. Shown with the values you are
# most likely to want to override.
# ---------------------------------------------------------------------------

# project_name = "app-starter-template"

# Regions. Put the VPS near the DATABASE, not near your users: a page render
# makes several sequential database round trips but only one user round trip,
# and Cloudflare terminates the user's TLS at its own edge. Neon's region is
# fixed at project creation, so decide before the first apply.
# neon_region    = "aws-eu-west-2"
# upstash_region = "af-south-1"

# Hostnames. app_domain_preview falls back to app_domain when unset, which
# points preview's OAuth callbacks at production — set it as soon as there is a
# hostname for staging.
# app_domain         = "example.com"
# app_domain_preview = "staging.example.com"
# app_domain_dev     = "localhost"

# OAuth. Leave blank to disable the provider — src/lib/auth.ts guards on
# truthiness, and src/env.ts declares these as legitimately-blank.
# google_client_id       = ""
# google_client_secret   = ""
# pocketid_client_id     = ""
# pocketid_client_secret = ""
# pocketid_base_url      = ""

# Email
# email_from     = "noreply@example.com"
# resend_api_key = ""

# Sentry. sentry_auth_token is what lets the build upload source maps; without
# it a production stack trace is minified and close to useless now that you own
# the runtime. It needs `project:releases` scope.
# sentry_org_slug          = ""
# sentry_team_slug         = ""
# sentry_integration_token = ""
# sentry_auth_token        = ""

# Analytics
# umami_base_url   = ""
# umami_website_id = ""

# Paystack
# paystack_secret_key     = ""
# paystack_secret_key_dev = ""

# Logging
# log_level = "info"
# no_color  = "true"
