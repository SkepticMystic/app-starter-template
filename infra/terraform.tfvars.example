# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is git-ignored — never commit real credentials.

# ---------------------------------------------------------------------------
# Provider credentials
# ---------------------------------------------------------------------------

neon_api_key = "your_neon_api_key"
neon_org_id  = "your_neon_org_id" # Settings → Organization → General

upstash_email   = "you@example.com"
upstash_api_key = "your_upstash_api_key"

cloudflare_api_token  = "your_cloudflare_api_token"
cloudflare_account_id = "your_cloudflare_account_id"

vercel_api_token = "your_vercel_api_token"
vercel_team_id   = "team_xxxxxxxxxxxxxxxxxxxxxxxx"


# ---------------------------------------------------------------------------
# Project config
# ---------------------------------------------------------------------------

github_repo = "owner/repo"
project_name   = "app-starter-template"
neon_region    = "aws-eu-west-2"
upstash_region = "eu-west-1"

# ---------------------------------------------------------------------------
# App secrets
# ---------------------------------------------------------------------------

# Generate with: openssl rand -hex 32
better_auth_secret = "your_better_auth_secret_min_32_chars"
better_auth_secret_dev = "your_better_auth_secret_dev_min_32_chars"

google_client_id     = "your_google_client_id"
google_client_secret = "your_google_client_secret"

pocketid_client_id     = "your_pocketid_client_id"
pocketid_client_secret = "your_pocketid_client_secret"
pocketid_base_url      = "https://pocketid.example.com"

email_from    = "hello@example.com"
resend_api_key = "re_your_resend_api_key"

sentry_org_slug = "your_sentry_org_slug"
sentry_team_slug = "your_sentry_team_slug"
sentry_integration_token = "your_sentry_integration_token"

umami_base_url   = "https://eu.umami.is"
umami_website_id = "your_umami_website_uuid"

paystack_secret_key = "sk_live_your_paystack_secret_key"
paystack_secret_key_dev = "sk_test_your_paystack_secret_key"

log_level = "info"

# ---------------------------------------------------------------------------
# Deploy target
# ---------------------------------------------------------------------------
# Leave true for Vercel. Set false to provision only the shared services
# (Neon, Upstash, Cloudflare, Sentry) for a container deploy.
deploy_vercel = true

# ---------------------------------------------------------------------------
# Cloudinary (required — no defaults)
# ---------------------------------------------------------------------------
cloudinary_cloud_name    = "your_cloudinary_cloud_name"
cloudinary_api_key       = "your_cloudinary_api_key"
cloudinary_api_secret    = "your_cloudinary_api_secret"
cloudinary_upload_preset = "your_cloudinary_unsigned_preset"

# ---------------------------------------------------------------------------
# OpenAI (required — no default). Used for content moderation.
# ---------------------------------------------------------------------------
openai_api_key = "sk-your_openai_api_key"
