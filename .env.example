# Copy to `.env` and fill in. This file is the manifest of every variable the
# app reads — `rg 'env\.[A-Z]' src/` and the `PUBLIC_*` imports are the source
# of truth, and `infra/` writes the same set to the deploy target.
#
# Vars are read at runtime via `$env/dynamic/private`, except APP_ENV and the
# PUBLIC_* set, which are baked in at build time.
#
# Values are deliberately UNQUOTED: `docker --env-file` does not strip quotes
# (it would hand the app a value with the quotes still in it), while
# `node --env-file` and dotenv accept either. Unquoted is the only form all
# three read identically. A `.env` produced by `vercel env pull` IS quoted, so
# strip them before passing it to docker:
#   sed -E 's/^([A-Z0-9_]+)="(.*)"$/\1=\2/' .env > .env.docker

# --- Tier -------------------------------------------------------------------
# Namespaces every Redis key (`<APP.ID>:<APP_ENV>:`). One Upstash instance is
# shared by all tiers and often other projects, so this is the ONLY isolation.
# Must be exactly one of: production | preview | development.
# Read statically on purpose: a missing value fails the build.
APP_ENV=development

# --- Public (compiled into the client bundle) -------------------------------
# These are baked in at BUILD time. Setting them in a container's runtime
# environment has no effect — pass them as docker build args instead. It is why
# an image is specific to one origin.
#
# The app's own origin. Drives auth callbacks, email links, the sitemap and the
# passkey RP ID, so it must match the hostname the app is actually served from.
PUBLIC_BASE_URL=http://localhost:5173
PUBLIC_SENTRY_DSN=
PUBLIC_CAPTCHA_SITE_KEY=
PUBLIC_UMAMI_BASE_URL=
PUBLIC_UMAMI_WEBSITE_ID=

# --- Database (Neon, or any Postgres) ---------------------------------------
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Redis (Upstash REST) ---------------------------------------------------
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=placeholder

# --- Auth -------------------------------------------------------------------
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
# Optional: both must be set for the Google provider to register.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: all three must be set for the generic OAuth (Pocket ID) provider.
POCKETID_BASE_URL=
POCKETID_CLIENT_ID=
POCKETID_CLIENT_SECRET=

# --- Object storage (Cloudflare R2, S3-compatible) --------------------------
CLOUDFLARE_ACCOUNT_ID=placeholder
R2_BUCKET_NAME=your-bucket
R2_ACCESS_KEY_ID=placeholder
R2_SECRET_ACCESS_KEY=placeholder

# --- Image hosting (Cloudinary) ---------------------------------------------
CLOUDINARY_CLOUD_NAME=placeholder
CLOUDINARY_API_KEY=placeholder
CLOUDINARY_API_SECRET=placeholder
# NOTE: read by `image_hosting.service.ts` but NOT yet written by `infra/`.
CLOUDINARY_UPLOAD_PRESET=placeholder

# --- Email (Resend) ---------------------------------------------------------
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=re_placeholder

# --- Payments (Paystack) ----------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_placeholder

# --- Captcha (Cloudflare Turnstile) -----------------------------------------
CAPTCHA_SECRET_KEY=placeholder

# --- Moderation (OpenAI) ----------------------------------------------------
OPENAI_API_KEY=sk-placeholder

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=debug
NO_COLOR=false

# --- Node server only (adapter-node; ignored on Vercel) ---------------------
# Set ORIGIN to the same value as PUBLIC_BASE_URL. Without it SvelteKit cannot
# derive the request URL and every form POST fails the CSRF origin check.
# ORIGIN="http://localhost:3000"
# PORT="3000"
# HOST="0.0.0.0"
# Number of trusted proxies in front of the app. Required for per-client rate
# limiting — without it every request looks like it came from the proxy.
# ADDRESS_HEADER="x-forwarded-for"
# XFF_DEPTH="1"
# BODY_SIZE_LIMIT="10M"
