{
  "name": "app-starter-template",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config && svelte-kit sync",
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test",
    "test:ui": "vp test --ui",
    "test:run": "vp test run",
    "test:coverage": "vp test run --coverage",
    "brand:generate": "bash scripts/brand/generate.sh",
    "knip": "knip",
    "knip:ci": "knip --files --dependencies",
    "scan:secrets": "docker run --rm -v \"$PWD:/pwd\" trufflesecurity/trufflehog:latest git file:///pwd --fail",
    "lint": "vp lint --report-unused-disable-directives",
    "lint:fix": "vp lint --fix --report-unused-disable-directives",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test:run && pnpm knip",
    "sonda": "SONDA=1 pnpm build",
    "check:slow": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings \"state_referenced_locally:ignore\"",
    "check": "svelte-kit sync && svelte-check --tsgo --incremental --tsconfig ./tsconfig.json --compiler-warnings \"state_referenced_locally:ignore\" && pnpm check:scripts",
    "check:scripts": "node node_modules/@typescript/native/bin/tsc -p tsconfig.scripts.json",
    "env:check": "vite-node ./scripts/env/check.script.ts",
    "auth:check": "vite-node ./scripts/auth/check.script.ts",
    "_db": "vite-node --options.transformMode.ssr='/.*/' ./scripts/drizzle/kit.script.ts",
    "db:push": "pnpm _db push",
    "db:push:explain": "pnpm _db push --explain",
    "db:generate": "dotenvx run --env-file=.env.production -- pnpm _db generate",
    "db:check": "dotenvx run --env-file=.env.production -- pnpm _db check",
    "db:migrate": "pnpm _db migrate",
    "db:migrate:run": "node --experimental-strip-types scripts/db/migrate.script.ts",
    "db:studio": "pnpm _db studio",
    "db:sql": "bash scripts/db/psql.sh",
    "db:sql:prod": "dotenvx run --env-file=.env.production -- bash scripts/db/psql.sh"
  },
  "dependencies": {
    "@alexasomba/paystack-node": "^1.10.8",
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/lib-storage": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@better-auth/api-key": "^1.7.7",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@better-auth/passkey": "^1.7.7",
    "@libpdf/core": "^0.5.1",
    "@neondatabase/serverless": "^1.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@sentry/sveltekit": "^11.4.0",
    "@unpic/svelte": "^1.0.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/functions": "^3.9.10",
    "better-auth": "^1.7.7",
    "better-auth-paystack": "3.2.1",
    "bits-ui": "^2.19.4",
    "cloudinary": "^2.11.0",
    "drizzle-orm": "1.0.0-rc.4",
    "ipaddr.js": "^2.5.0",
    "isomorphic-dompurify": "^4.4.0",
    "marked": "^18.0.14",
    "mode-watcher": "^1.1.0",
    "pino": "^10.3.1",
    "qrcode-generator": "^2.0.4",
    "resend": "^6.32.0",
    "runed": "^0.37.1",
    "sharp": "^0.35.5",
    "super-sitemap": "^2.0.6",
    "svelte-meta-tags": "^5.0.2",
    "svelte-sonner": "^1.2.1",
    "thumbhash": "^0.1.1",
    "unpic": "^4.2.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.32.4",
    "@iconify-json/lucide": "^1.2.138",
    "@iconify/tailwind4": "^1.2.3",
    "@internationalized/date": "^3.12.4",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/adapter-vercel": "^7.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/svelte-table": "^9.2.4",
    "@types/node": "^26.6.4",
    "@types/umami": "^2.10.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "auth": "^1.7.7",
    "drizzle-kit": "1.0.0-rc.4",
    "knip": "^6.39.0",
    "pino-pretty": "^13.1.3",
    "sonda": "^0.14.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-toolbelt": "^0.10.6",
    "svelte-turnstile": "^0.11.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "catalog:",
    "vite-node": "^6.0.0",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.5.1",
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
