{
  "name": "app-starter-template",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test",
    "test:ui": "vp test --ui",
    "test:run": "vp test run",
    "test:coverage": "vp test run --coverage",
    "knip": "knip",
    "scan:secrets": "docker run --rm -v \"$PWD:/pwd\" trufflesecurity/trufflehog:latest git file:///pwd --fail",
    "lint": "vp lint --report-unused-disable-directives",
    "lint:fix": "vp lint --fix --report-unused-disable-directives",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test:run && pnpm knip",
    "sonda": "SONDA=1 pnpm build",
    "check:slow": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings \"state_referenced_locally:ignore\"",
    "check": "svelte-kit sync && svelte-check --tsgo --incremental --tsconfig ./tsconfig.json --compiler-warnings \"state_referenced_locally:ignore\"",
    "_db": "vite-node --options.transformMode.ssr='/.*/' ./scripts/drizzle/kit.script.ts",
    "db:push": "pnpm _db push",
    "db:push:explain": "pnpm _db push --explain",
    "db:generate": "dotenvx run --env-file=.env.production -- pnpm _db generate",
    "db:check": "dotenvx run --env-file=.env.production -- pnpm _db check",
    "db:migrate": "pnpm _db migrate",
    "db:studio": "pnpm _db studio",
    "db:sql": "bash scripts/db/psql.sh",
    "db:sql:prod": "dotenvx run --env-file=.env.production -- bash scripts/db/psql.sh"
  },
  "dependencies": {
    "@alexasomba/paystack-node": "^1.10.8",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@better-auth/api-key": "^1.7.5",
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@better-auth/passkey": "^1.7.5",
    "@libpdf/core": "^0.4.2",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/sveltekit": "^10.75.0",
    "@unpic/svelte": "^1.0.1",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.38.4",
    "better-auth": "^1.7.5",
    "better-auth-paystack": "3.2.1",
    "bits-ui": "^2.19.2",
    "drizzle-orm": "1.0.0-rc.4",
    "marked": "^18.0.13",
    "mode-watcher": "^1.1.0",
    "pino": "^10.3.1",
    "qrcode-generator": "^2.0.4",
    "resend": "^6.28.1",
    "runed": "^0.37.1",
    "svelte-meta-tags": "^5.0.2",
    "svelte-sonner": "^1.2.1",
    "unpic": "^4.2.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.75.1",
    "@iconify-json/lucide": "^1.2.134",
    "@iconify/tailwind4": "^1.2.3",
    "@internationalized/date": "^3.12.4",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/svelte-table": "^9.2.4",
    "@tanstack/table-core": "^9.2.4",
    "@types/node": "^26.6.2",
    "@types/umami": "^2.10.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vercel/functions": "^3.9.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "cloudinary": "^2.11.0",
    "drizzle-kit": "1.0.0-rc.4",
    "isomorphic-dompurify": "2.26.0",
    "knip": "^6.37.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.4",
    "sonda": "^0.14.0",
    "super-sitemap": "^1.0.12",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-toolbelt": "^0.10.6",
    "svelte-turnstile": "^0.11.0",
    "sveltekit-flash-message": "^2.4.6",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "thumbhash": "^0.1.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "catalog:",
    "vite-node": "^6.0.0",
    "vite-plugin-devtools-json": "^1.1.0",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "packageManager": "pnpm@12.3.4"
}
